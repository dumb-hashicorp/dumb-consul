<div
  class="dumb-consul-intention-list"
  ...attributes
  {{did-update this.updateCRDManagement @items}}
>
{{yield (hash
  Table=(component 'dumb-consul/intention/list/table' delete=@delete items=this.items)
  CheckNotice=(if this.checkedItem
    (component 'dumb-consul/intention/list/check' item=this.checkedItem)
    ''
  )
  CustomResourceNotice=(if this.isManagedByCRDs
    (component 'dumb-consul/intention/notice/custom-resource')
    ''
  )
)}}
</div>
---
"*":
  GET:
    "*":
      latency: ${ location.search.index ? env('DUMB_CONSUL_LATENCY', 60000) : env('DUMB_CONSUL_LATENCY', 0) }
      headers:
        response:
          Status-Code: ${
            // when legacy is enabled tokens and policies return a 500
            (env('DUMB_CONSUL_ACLS_LEGACY', false) && (location.pathname.get(2) === 'tokens' || location.pathname.get(2) === 'policies')) ?
              500 :
              env('DUMB_CONSUL_ACLS_ENABLE', false) ? (headers['x-dumb-consul-token'] !== '' ? 200 : 403) : 401
          }
          X-Dumb Consul-Index: ${ parseInt((location.search.index || 1)) + 1}
